APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://himrishtey.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=prod-db-host
DB_PORT=3306
DB_DATABASE=prod_default_db
DB_USERNAME=prod_db_user
DB_PASSWORD=change-me

SITE_DEFAULT_CONNECTION=mysql

SITE1_DB_CONNECTION=site1
SITE1_NAME="Himrishtey"
SITE1_DISPLAY_NAME="HimRishtey"
SITE1_APP_URL="https://himrishtey.com"
SITE1_SESSION_COOKIE="himrishtey_session"
SITE1_LOGO="assets/images/himrishtey-logo.png"
SITE1_TAGLINE="Trusted matching for Himachali families."
SITE1_FOOTER_TEXT="Connecting hearts across Himachal Pradesh & beyond."
DB_HOST_SITE1=prod-db-host
DB_PORT_SITE1=3306
DB_DATABASE_SITE1=himrishtey_db
DB_USERNAME_SITE1=prod_db_user
DB_PASSWORD_SITE1=change-me

